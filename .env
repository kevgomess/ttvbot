# Canal onde os bots vão atuar (seu canal de streamer, sem @)
TWITCH_CHANNEL=kevfps1

# Chave da API do Groq — GRATUITA, sem cartão de crédito
# Pega em https://console.groq.com (crie conta e vá em "API Keys")
GROQ_API_KEY=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

# Modelo de texto usado para gerar as mensagens.
# openai/gpt-oss-20b é o recomendado atualmente pela Groq (rápido e com bom limite gratuito).
# Se um dia esse modelo também for descontinuado, veja a lista atual em:
# https://console.groq.com/docs/models
GROQ_MODEL=openai/gpt-oss-20b

# Nome que os bots vão usar pra se referir a você
STREAMER_NOME=

# Jogo atual (pode mudar isso manualmente ou automatizar depois via API da Twitch)
JOGO_ATUAL=cs2

# Ativa a escuta do microfone (true/false). Precisa do naudiodon funcionando.
ESCUTA_ATIVA=true

# Duração de cada trecho gravado antes de transcrever, em segundos
DURACAO_GRAVACAO_SEGUNDOS=20

# ID do dispositivo de microfone. Deixe -1 para usar o padrão do sistema.
# Para listar os dispositivos disponíveis, rode: npm run listar-microfones
AUDIO_DEVICE_ID=-1

# ---------------------------------------------------------------------
# As credenciais e personalidades de CADA BOT ficam em config/bots.json
# (copie config/bots.example.json para config/bots.json e preencha)
# ---------------------------------------------------------------------
